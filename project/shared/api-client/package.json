{
  "name": "@shared/api-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/api/index.js",
  "types": "dist/api/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./client": {
      "types": "./dist/api/client/index.d.ts",
      "default": "./dist/api/client/index.js"
    },
    "./client.gen": {
      "types": "./dist/api/client.gen.d.ts",
      "default": "./dist/api/client.gen.js"
    }
  },
  "scripts": {
    "generate:api": "openapi-ts",
    "generate:api:watch": "nodemon --watch ../../apps/backend/openapi.json --watch openapi-ts.config.ts --exec pnpm run build",
    "compile": "tsc -p tsconfig.build.json",
    "build": "pnpm run generate:api && pnpm run compile"
  },
  "dependencies": {
    "axios": "^1.15.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.0",
    "@types/node": "^22.19.17",
    "nodemon": "^3.1.14",
    "typescript": "^5.6.3"
  }
}
