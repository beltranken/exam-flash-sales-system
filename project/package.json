{
  "name": "exam-flash-sales-system",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "prepare": "lefthook install",
    "lint": "pnpm -r lint",
    "dev": "pnpm -r --parallel dev",
    "dev:shared": "pnpm --parallel -r --filter \"@shared/*\" dev",
    "dev:services": "pnpm --parallel -r --filter \"@services/*\" dev",
    "dev:apps": "pnpm --parallel -r --filter \"@apps/*\" dev",
    "dev:frontend": "pnpm --parallel -r --filter @apps/frontend dev",
    "prepare-env": "node scripts/prepare-env.mjs",
    "code-gen": "pnpm -r --parallel --if-present run \"/^generate:[A-Za-z]+$/\"",
    "code-gen:watch": "pnpm -r --parallel --if-present run \"/^generate:[A-Za-z]+:watch$/\"",
    "build": "pnpm -r build",
    "build:shared": "pnpm -r --filter \"@shared/*\" build",
    "build:backend": "pnpm --filter @apps/backend build",
    "build:main": "pnpm -r --filter=!@shared/api-client --filter=!@apps/frontend build",
    "build:frontend": "pnpm --filter=@shared/api-client build && pnpm --filter=@apps/frontend build",
    "docker:test:stress": "docker compose -f ../infra/local/docker-compose.all.yml --profile stress run --rm -e STRESS_SCENARIO=flash-sale k6",
    "docker:up": "docker compose -f ../infra/local/docker-compose.all.yml up --build -d",
    "docker:down": "docker compose -f ../infra/local/docker-compose.all.yml down",
    "test:unit": "pnpm -r --sequential test:unit",
    "test:integration": "pnpm -r --sequential test:integration",
    "test:coverage": "pnpm -r --sequential test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "lefthook": "^2.1.4",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.0"
  }
}
