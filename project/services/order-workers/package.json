{
  "name": "@services/order-workers",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --passWithNoTests --testPathIgnorePatterns=\\.integration\\.test\\.ts$",
    "test:integration": "jest --passWithNoTests --testPathPattern=\\.integration\\.test\\.ts$",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@shared/cache-contracts": "workspace:*",
    "@shared/db": "workspace:*",
    "@shared/logger": "workspace:*",
    "@shared/order-contracts": "workspace:*",
    "amqplib": "^1.0.3",
    "dotenv": "^17.4.2",
    "ioredis": "^5.10.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
